{
  "name": "async-task-scheduler",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w @ats/api",
    "dev:worker": "npm run dev -w @ats/worker",
    "db:generate": "npm run db:generate -w @ats/database",
    "db:migrate": "npm run db:migrate -w @ats/database --",
    "db:smoke": "npm run db:smoke -w @ats/database",
    "queue:smoke": "npm run queue:smoke -w @ats/queue",
    "db:studio": "npm run db:studio -w @ats/database --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
