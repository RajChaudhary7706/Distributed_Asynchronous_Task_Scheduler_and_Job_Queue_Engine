# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- API ----------
API_PORT=3000

# ---------- Worker ----------
WORKER_ID=worker-local-01

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_scheduler
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_scheduler?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Job types: retry limits (used from Phase 4; backoff added in Phase 7) ----------
PDF_MAX_ATTEMPTS=3
EMAIL_MAX_ATTEMPTS=5
VIDEO_MAX_ATTEMPTS=3

# ---------- Job types: jobs one worker PROCESS runs in parallel (used from Phase 5) ----------
PDF_CONCURRENCY=2
EMAIL_CONCURRENCY=10
VIDEO_CONCURRENCY=1

# ---------- API: enqueue recovery sweeper (Phase 4) ----------
SWEEP_INTERVAL_MS=10000
SWEEP_GRACE_MS=15000
SWEEP_BATCH_SIZE=100

# ---------- Chaos testing (Phase 18). Keep false in production ----------
CHAOS_ENABLED=true